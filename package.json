{
  "name": "docula-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:ci": "pnpm -r run lint:ci",
    "test": "pnpm lint && pnpm -r run test",
    "test:ci": "pnpm lint:ci && pnpm -r run test",
    "clean": "pnpm -r run clean && rimraf dist coverage node_modules package-lock.json yarn.lock pnpm-lock.yaml site/dist",
    "test:binary": "node packages/docula/scripts/test-binary.ts",
    "build:binary": "pnpm --filter docula run build:binary",
    "test:e2e": "pnpm -r run test:e2e",
    "generate-init-file": "pnpm --filter docula run generate-init-file",
    "generate-embedded-templates": "pnpm --filter docula run generate-embedded-templates",
    "docula:help": "pnpm --filter docula run docula:help",
    "website:build": "docula build -s ./site -o ./site/dist",
    "website:dev": "pnpm build && docula dev -s ./site -p 3333",
    "website:mapi": "pnpm --filter docula run website:mapi",
    "website:mega": "pnpm --filter docula run website:mega",
    "website:mega:custom": "pnpm --filter docula run website:mega:custom",
    "website:singlepage": "pnpm --filter docula run website:singlepage",
    "website:nohome": "pnpm --filter docula run website:nohome",
    "website:changelog": "pnpm --filter docula run website:changelog"
  },
  "devDependencies": {
    "docula": "workspace:*",
    "dotenv": "^17.4.2",
    "rimraf": "^6.1.3"
  }
}
